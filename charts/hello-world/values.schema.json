{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hello-world chart values",
  "description": "Catches type and enum mistakes at install time. Cross-field rules that JSON Schema cannot express (duration formats, PDB vs replica count) are enforced in _helpers.tpl.",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$",
          "description": "Must be a full sha256 digest, or empty to use the tag."
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "type": "object" },
    "commonAnnotations": { "type": "object" },
    "config": {
      "type": "object",
      "properties": {
        "message": { "type": "string", "minLength": 1 },
        "logLevel": { "enum": ["debug", "info", "warn", "error"] },
        "drainDelay": { "type": "string" },
        "shutdownTimeout": { "type": "string" }
      }
    },
    "extraEnv": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "automountServiceAccountToken": { "type": "boolean" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" },
        "nodePort": { "type": ["integer", "string", "null"] },
        "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metricsService": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": ["string", "number"] }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": ["string", "number", "null"] },
            "memory": { "type": ["string", "number", "null"] }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "string", "null"] },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "string", "null"] },
        "behavior": { "type": "object" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "topologySpread": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "zone": {
          "type": "object",
          "properties": {
            "maxSkew": { "type": "integer", "minimum": 1 },
            "whenUnsatisfiable": { "enum": ["DoNotSchedule", "ScheduleAnyway"] }
          }
        },
        "node": {
          "type": "object",
          "properties": {
            "maxSkew": { "type": "integer", "minimum": 1 },
            "whenUnsatisfiable": { "enum": ["DoNotSchedule", "ScheduleAnyway"] }
          }
        }
      }
    },
    "updateStrategy": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowAllHTTPIngress": { "type": "boolean" },
        "httpFrom": { "type": "array" },
        "metricsFrom": { "type": "array" },
        "restrictEgress": { "type": "boolean" },
        "extraEgress": { "type": "array" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "probes": {
      "type": "object",
      "properties": {
        "startup": { "type": "object" },
        "liveness": { "type": "object" },
        "readiness": { "type": "object" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "labels": { "type": "object" },
        "relabelings": { "type": "array" },
        "metricRelabelings": { "type": "array" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "tests": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "object" }
      }
    }
  }
}
