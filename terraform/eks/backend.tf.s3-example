# Remote state in S3. Not active by default; this project uses local state.
# To enable: apply ../bootstrap, rename this to backend.tf, fill in the bucket
# name, then run `terraform init -migrate-state`.

terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_BUCKET_NAME"
    key          = "eks/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
