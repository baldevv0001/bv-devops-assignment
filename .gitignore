# Build artefacts
bin/
dist/
*.out
coverage.html

# Terraform (populated from Part 3 onward)
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# tfvars can carry account IDs and other environment detail, so they are
# excluded by default. The per-environment files under terraform/*/environments
# are the exception: they hold only region, sizing and CIDR choices, and are
# meant to be read as part of the configuration.
*.auto.tfvars
*.tfvars
!*.tfvars.example
!terraform/*/environments/*.tfvars

# Terraform lock files ARE committed: they pin provider checksums, which is
# what makes a plan reproducible across machines and in CI.
!.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan
*.tfplan

# Helm
charts/**/charts/
*.tgz

# Credentials — never commit these
.env
*.pem
*.key
kubeconfig
kubeconfig-*

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
