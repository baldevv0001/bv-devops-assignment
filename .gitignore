# Build artefacts
bin/
dist/
*.out
coverage.html

# Terraform (populated from Part 3 onward)
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# tfvars can carry account detail, so they are excluded. The per-environment
# files hold only region, sizing and CIDR choices, so they are kept.
*.auto.tfvars
*.tfvars
!*.tfvars.example
!terraform/*/environments/*.tfvars

# Lock files are committed: they pin provider checksums for reproducible plans.
!.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan
*.tfplan

# Helm
charts/**/charts/
*.tgz

# Credentials
.env
*.pem
*.key
kubeconfig
kubeconfig-*

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
